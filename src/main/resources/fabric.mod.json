{
  "schemaVersion": 1,
  "id": "swordthrow",
  "version": "${version}",
  "name": "Sword Throw",
  "description": "Throw swords like daggers, stick them in blocks, pull them out.",
  "authors": ["Nesonaragirl"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["net.nesona.swordthrow.SwordThrowMod"],
    "client": ["net.nesona.swordthrow.client.SwordThrowClient"]
  },
  "mixins": [
    { "config": "swordthrow.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
